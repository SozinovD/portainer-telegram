# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# URL Portainer Server.
# Если бот развёрнут как stack в Portainer на том же хосте:
#   http://host.docker.internal:9000
# Если контейнер в одной docker-сети с сервером Portainer:
#   http://portainer:9000
PORTAINER_URL=http://host.docker.internal:9000

# API-ключ: Portainer → My Account → API Tokens → Add token
PORTAINER_API_KEY=ptr_

# ID endpoint (окружения) Portainer. Пусто = все endpoints по очереди / выбор кнопкой
PORTAINER_ENDPOINT_ID=

# Whitelist chat'ов через запятую. Пусто = доступ всем (небезопасно!)
ALLOWED_CHAT_IDS=
